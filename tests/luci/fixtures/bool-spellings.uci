config global 'config'
	option enabled 'yes'
	option node_priority '100'
	option vrrp_transport 'multicast'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option nopreempt 'yes'
	option advert_int '1'

config vrrp_instance 'guest'
	option vrid '52'
	option interface 'lan'
	option nopreempt 'no'
	option advert_int '1'

config vip 'lan'
	option enabled 'yes'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config vip 'lan_old'
	option enabled 'off'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.253'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'edge-router'
	option address '172.30.0.20'
	option vrrp_only 'yes'

config advanced 'advanced'
	option log_level '2'
	option enable_notifications 'yes'
	list notification_email 'admin@example.com'
	option smtp_server '192.168.50.2'
