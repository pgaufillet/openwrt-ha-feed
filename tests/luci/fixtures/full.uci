config global 'config'
	option enabled '1'
	option node_priority '150'
	option vrrp_transport 'unicast'
	option sync_method 'owsync'
	option encryption_key '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '1'
	option advert_int '1'

config vrrp_instance 'vpn'
	option vrid '52'
	option interface 'backend'
	option advert_int '2'
	option preempt_delay '30'
	option auth_type 'pass'
	option auth_pass 'secret1'
	option unicast_src_ip '172.30.0.10'
	list unicast_peer '172.30.0.11'
	list track_interface 'lan'
	list track_script 'check_gateway'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'
	option address6 'fd00:192:168:50::254'
	option prefix6 '64'

config vip 'lan_old'
	option enabled '0'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.253'
	option netmask '255.255.255.0'

config vip 'vpn6'
	option enabled '1'
	option vrrp_instance 'vpn'
	option interface 'backend'
	option address6 'fd00:172:30::254'
	option prefix6 '64'

config peer 'peer1'
	option name 'ha-node2'
	option address '172.30.0.11'
	option source_address '172.30.0.10'

config peer 'peer2'
	option name 'edge-router'
	option address 'fd00:172:30::20'
	option source_address 'fd00:172:30::10'
	option sync_enabled '0'

config peer 'peer3'
	option name 'legacy'
	option address '172.30.0.12'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '1'
	list config_files 'firewall'

config service 'openvpn'
	option enabled '1'
	list config_files 'openvpn'
	list config_files '/etc/openvpn/keys'

config service 'mwan3'
	option enabled '0'
	list config_files 'mwan3'

config advanced 'advanced'
	option log_level '3'
	option owsync_log_level '1'
	option sync_interval '45'
	option lease_sync_port '5379'
	option lease_sync_interval '20'
	option lease_sync_peer_timeout '80'
	option lease_sync_persist_interval '300'
	option lease_sync_log_level '3'
	option max_auto_priority '0'
	option enable_notifications '1'
	list notification_email 'admin@example.com'
	list notification_email 'noc@example.com'
	option notification_email_from 'ha@example.com'
	option smtp_server '192.168.50.2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'
	list file 'wireless'

config script 'check_gateway'
	option script '/bin/ping -c 1 -W 1 192.168.50.1'
	option interval '5'
	option timeout '2'
	option weight '-10'
	option rise '2'
	option fall '2'
