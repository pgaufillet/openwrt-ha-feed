== /etc/config/ha-cluster
config config 'config'
	option enabled '1'

config service 'dhcp'
	option sync_leases 'off'
	list config_files 'dhcp'

config service 'misc'
	option sync_leases '1'
	list config_files 'uhttpd'
== migration rc=0
== /etc/config/ha-cluster

config config 'config'
	option enabled '1'
	option lease_sync '0'

config sync_group 'dhcp'
	list config_files 'dhcp'

config sync_group 'misc'
	list config_files 'uhttpd'

