== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option node_priority '100'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'

config vrrp_instance 'main'
	option vrid '64'
	option interface 'lan'
	option priority '100'
	option nopreempt '1'
	option advert_int '1'

config vip
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.1.254'
	option netmask '255.255.255.0'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'
	option owsync_log_level '2'
	option sync_interval '30'
	option lease_sync_port '5378'
	option lease_sync_interval '30'
	option lease_sync_peer_timeout '120'
	option lease_sync_persist_interval '60'
	option lease_sync_log_level '2'
	option max_auto_priority '0'
	option enable_notifications '0'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'
	list file 'wireless'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

== start_service
instance [keepalived]
	set [command] [/usr/sbin/keepalived]
	append [command] [-n]
	append [command] [-f] [/tmp/ha-cluster/keepalived.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
instance [owsync]
	set [command] [/usr/bin/owsync] [daemon]
	append [command] [-c] [/tmp/ha-cluster/owsync.conf]
	set [file] [/tmp/ha-cluster/owsync.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
instance [lease-sync]
	set [command] [/usr/sbin/lease-sync]
	append [command] [-c] [/tmp/ha-cluster/lease-sync.conf]
	set [file] [/tmp/ha-cluster/lease-sync.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
rc=0
== service_triggers
reload_trigger [ha-cluster]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.warning|No peers configured - HA will not function
ha-cluster|daemon.info|Taking over service management from standalone init scripts
ha-cluster|daemon.info|Disabled standalone service: keepalived
ha-cluster|daemon.info|Wrote dnsmasq HA overlay to /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
ha-cluster|daemon.info|dnsmasq restarted
ha-cluster|daemon.info|Generating keepalived configuration for node: ha-char
ha-cluster|daemon.info|Keepalived configuration generated at /tmp/ha-cluster/keepalived.conf
ha-cluster|daemon.info|Generating owsync configuration
ha-cluster|daemon.warning|No encryption_key set - owsync will run without encryption
ha-cluster|daemon.warning|For production: Generate a key with 'owsync genkey' and set it in both nodes
ha-cluster|daemon.warning|Add to /etc/config/ha-cluster: option encryption_key '<your-key>'
ha-cluster|daemon.info|owsync configuration generated at /tmp/ha-cluster/owsync.conf
ha-cluster|daemon.info|Generating lease-sync configuration
ha-cluster|daemon.warning|lease-sync running in plain mode - ensure network-layer security
ha-cluster|daemon.info|lease-sync configuration generated at /tmp/ha-cluster/lease-sync.conf
ha-cluster|daemon.info|HA cluster configuration applied successfully
ha-cluster|daemon.info|Starting keepalived daemon
ha-cluster|daemon.info|Starting owsync daemon
ha-cluster|daemon.info|Starting lease-sync daemon
== ls /tmp/ha-cluster
keepalived.conf
lease-sync.conf
owsync.conf
== /tmp/ha-cluster/keepalived.conf
! Keepalived configuration - Generated by ha-cluster
! DO NOT EDIT - This file is auto-generated when HA cluster is enabled
! Edit /etc/config/ha-cluster instead

global_defs {
    router_id ha-char
    dynamic_interfaces
    script_user root
    enable_script_security
    max_auto_priority 0
}

vrrp_instance main {
    state BACKUP
    interface lan
    virtual_router_id 64
    priority 100
    advert_int 1
    nopreempt
    virtual_ipaddress {
        192.168.1.254/24 dev lan
    }

    # Notify scripts for state changes
    notify_master "/bin/busybox env -i ACTION=MASTER TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_backup "/bin/busybox env -i ACTION=BACKUP TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_fault "/bin/busybox env -i ACTION=FAULT TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
}

== /tmp/ha-cluster/owsync.conf
# Auto-generated by ha-cluster
# DO NOT EDIT - changes will be overwritten when HA cluster restarts
# Edit /etc/config/ha-cluster instead

# Network settings
bind_host=::
port=4321

# Paths (OpenWrt-specific)
sync_dir=/etc/config
database=/etc/owsync/owsync.db

# Daemon settings
poll_interval=30
log_level=2

# Security: Plain mode (use only over secure VPN)
plain_mode=1

# Peers

# Include patterns (sync these files)
include=dhcp

# Exclude patterns (never sync these)
exclude=network
exclude=system
exclude=owsync
exclude=ha-cluster
exclude=wireless
== /tmp/ha-cluster/lease-sync.conf
# Auto-generated by ha-cluster
# DO NOT EDIT - changes will be overwritten when HA cluster restarts
# Edit /etc/config/ha-cluster instead

node_id=ha-char
sync_port=5378
sync_interval=30
peer_timeout=120
persist_interval=60
log_level=2

# Security: Plain mode (use only over secure VPN)
# WARNING: Ensure network-layer security (WireGuard/IPsec) is configured!
security_mode=plain
plain_mode_acknowledged=1

== ls /tmp/dnsmasq.cfg01411c.d
ha-cluster.conf
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
# Auto-generated by ha-cluster — do not edit
# Call dhcp-script on lease renewals so lease-sync can track expiry changes
script-on-renewal
== ls /etc/ha-cluster
service_states
== /etc/ha-cluster/service_states
keepalived=1
== rc.d
K10lease-sync
K10owsync
K91ha-cluster
S25ha-cluster
S99lease-sync
S99owsync
