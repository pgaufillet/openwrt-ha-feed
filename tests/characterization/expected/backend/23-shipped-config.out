== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option node_priority '100'
	option vrrp_transport 'multicast'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '64'
	option interface 'lan'
	option priority '100'
	option nopreempt '1'
	option advert_int '1'

config vip
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.1.254'
	option netmask '255.255.255.0'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'
	option owsync_log_level '2'
	option sync_interval '30'
	option lease_sync_port '5378'
	option lease_sync_interval '30'
	option lease_sync_peer_timeout '120'
	option lease_sync_log_level '2'
	option max_auto_priority '0'
	option enable_notifications '0'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'
	list file 'wireless'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option node_priority '100'
	option vrrp_transport 'multicast'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '64'
	option interface 'lan'
	option priority '100'
	option nopreempt '1'
	option advert_int '1'

config vip
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.1.254'
	option netmask '255.255.255.0'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'
	option owsync_log_level '2'
	option sync_interval '30'
	option lease_sync_port '5378'
	option lease_sync_interval '30'
	option lease_sync_peer_timeout '120'
	option lease_sync_log_level '2'
	option max_auto_priority '0'
	option enable_notifications '0'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'
	list file 'wireless'

== start_service
instance [keepalived]
	set [command] [/usr/sbin/keepalived]
	append [command] [-n]
	append [command] [-f] [/tmp/ha-cluster/keepalived.conf]
	set [file] [/tmp/ha-cluster/keepalived.conf]
	set [reload_signal] [HUP]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
rc=0
== service_triggers
reload_trigger [ha-cluster]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.warning|No peers configured - HA will not function
ha-cluster|daemon.info|Taking over service management from standalone init scripts
ha-cluster|daemon.info|Disabled standalone service: keepalived
ha-cluster|daemon.info|Disabled standalone service: owsync
lease-sync|daemon.info|Stopping lease-sync daemon
ha-cluster|daemon.info|Disabled standalone service: lease-sync
ha-cluster|daemon.info|Generating keepalived configuration for node: ha-char
ha-cluster|daemon.info|Keepalived configuration generated at /tmp/ha-cluster/keepalived.conf
ha-cluster|daemon.info|HA cluster configuration applied successfully
ha-cluster|daemon.info|Starting keepalived daemon
== ls /tmp/ha-cluster
keepalived.conf
== /tmp/ha-cluster/keepalived.conf
! Keepalived configuration - Generated by ha-cluster
! DO NOT EDIT - This file is auto-generated when HA cluster is enabled
! Edit /etc/config/ha-cluster instead

global_defs {
    router_id ha-char
    dynamic_interfaces
    script_user root
    enable_script_security
    max_auto_priority 0
}

vrrp_instance main {
    state BACKUP
    interface lan
    virtual_router_id 64
    priority 100
    advert_int 1
    nopreempt
    virtual_ipaddress {
        192.168.1.254/24 dev lan
    }

    # Notify scripts for state changes
    notify_master "/bin/busybox env -i ACTION=MASTER TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_backup "/bin/busybox env -i ACTION=BACKUP TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_fault "/bin/busybox env -i ACTION=FAULT TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
}

== /tmp/ha-cluster/owsync.conf
(absent)
== /tmp/ha-cluster/lease-sync.conf
(absent)
== ls /tmp/dnsmasq.cfg01411c.d
(absent)
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
(absent)
== ls /etc/ha-cluster
service_states
== /etc/ha-cluster/service_states
keepalived=1
owsync=1
lease-sync=1
== rc.d
K91ha-cluster
S25ha-cluster
