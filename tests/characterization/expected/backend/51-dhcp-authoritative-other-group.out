cfg03411c
== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config service 'dhcp'
	option enabled '1'
	option sync_leases '0'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

config service 'shared'
	list config_files 'firewall'
	list config_files 'dhcp'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

config dnsmasq
	option authoritative 'yes'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'
	option lease_sync '0'

config vrrp_instance 'main'
	option vrid '51'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config sync_group 'dhcp'
	option enabled '1'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

config sync_group 'shared'
	list config_files 'firewall'
	list config_files 'dhcp'

== start_service
instance [keepalived]
	set [command] [/usr/sbin/keepalived]
	append [command] [-n]
	append [command] [-f] [/tmp/ha-cluster/keepalived.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
instance [owsync]
	set [command] [/usr/bin/owsync] [daemon]
	append [command] [-c] [/tmp/ha-cluster/owsync.conf]
	set [file] [/tmp/ha-cluster/owsync.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
rc=0
== service_triggers
reload_trigger [ha-cluster]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.info|Taking over service management from standalone init scripts
ha-cluster|daemon.info|Disabled standalone service: keepalived
ha-cluster|daemon.info|Disabled standalone service: owsync
lease-sync|daemon.info|Stopping lease-sync daemon
ha-cluster|daemon.info|Disabled standalone service: lease-sync
ha-cluster|daemon.info|Generating keepalived configuration for node: ha-char
ha-cluster|daemon.info|Keepalived configuration generated at /tmp/ha-cluster/keepalived.conf
ha-cluster|daemon.info|Generating owsync configuration
ha-cluster|daemon.info|owsync configuration generated at /tmp/ha-cluster/owsync.conf
ha-cluster|daemon.info|HA cluster configuration applied successfully
ha-cluster|daemon.info|Starting keepalived daemon
ha-cluster|daemon.info|Starting owsync daemon
== ls /tmp/ha-cluster
keepalived.conf
owsync.conf
== /tmp/ha-cluster/keepalived.conf
! Keepalived configuration - Generated by ha-cluster
! DO NOT EDIT - This file is auto-generated when HA cluster is enabled
! Edit /etc/config/ha-cluster instead

global_defs {
    router_id ha-char
    dynamic_interfaces
    script_user root
    enable_script_security
    max_auto_priority 0
}

vrrp_instance main {
    state BACKUP
    interface lan
    virtual_router_id 51
    priority 200
    advert_int 1
    virtual_ipaddress {
        192.168.50.254/24 dev lan
    }

    # Notify scripts for state changes
    notify_master "/bin/busybox env -i ACTION=MASTER TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_backup "/bin/busybox env -i ACTION=BACKUP TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
    notify_fault "/bin/busybox env -i ACTION=FAULT TYPE=INSTANCE NAME=main /sbin/hotplug-call keepalived"
}

== /tmp/ha-cluster/owsync.conf
# Auto-generated by ha-cluster
# DO NOT EDIT - changes will be overwritten when HA cluster restarts
# Edit /etc/config/ha-cluster instead

# Network settings
bind_host=::
port=4321

# Paths (OpenWrt-specific)
sync_dir=/etc/config
database=/etc/owsync/owsync.db

# Daemon settings
poll_interval=30
log_level=2

# Security: PSK encryption enabled
encryption_key=7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e

# Peers
peer=172.30.0.11

# Include patterns (sync these files)
include=firewall
include=dhcp

# Exclude patterns (never sync these)
exclude=network
exclude=system
exclude=owsync
exclude=ha-cluster
== /tmp/ha-cluster/lease-sync.conf
(absent)
== ls /tmp/dnsmasq.cfg01411c.d
(absent)
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
(absent)
== ls /etc/ha-cluster
service_states
== /etc/ha-cluster/service_states
keepalived=1
owsync=1
lease-sync=1
== rc.d
K91ha-cluster
S25ha-cluster
== reload
instance [keepalived]
	set [command] [/usr/sbin/keepalived]
	append [command] [-n]
	append [command] [-f] [/tmp/ha-cluster/keepalived.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
instance [owsync]
	set [command] [/usr/bin/owsync] [daemon]
	append [command] [-c] [/tmp/ha-cluster/owsync.conf]
	set [file] [/tmp/ha-cluster/owsync.conf]
	set [respawn]
	set [stdout] [1]
	set [stderr] [1]
end
signal [ha-cluster] [keepalived] [SIGHUP]
rc=0
== log
ha-cluster|daemon.info|Reloading HA cluster configuration
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.info|Taking over service management from standalone init scripts
ha-cluster|daemon.info|Generating keepalived configuration for node: ha-char
ha-cluster|daemon.info|Keepalived configuration generated at /tmp/ha-cluster/keepalived.conf
ha-cluster|daemon.info|Generating owsync configuration
ha-cluster|daemon.info|owsync configuration generated at /tmp/ha-cluster/owsync.conf
ha-cluster|daemon.info|HA cluster configuration applied successfully
ha-cluster|daemon.info|Starting keepalived daemon
ha-cluster|daemon.info|Starting owsync daemon
== ls /tmp/ha-cluster
keepalived.conf
owsync.conf
