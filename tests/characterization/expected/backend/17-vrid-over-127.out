== uci
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'

config vrrp_instance 'main'
	option vrid '128'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config service 'dhcp'
	option enabled '1'
	option sync_leases '1'
	list config_files 'dhcp'

config service 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

package dhcp

config dnsmasq
	option domain 'lan'
	option leasefile '/tmp/dhcp.leases'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option force '1'

== uci after migration
package ha-cluster

config global 'config'
	option enabled '1'
	option vrrp_transport 'multicast'
	option sync_method 'owsync'
	option encryption_key '7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e'
	option lease_sync '1'

config vrrp_instance 'main'
	option vrid '128'
	option interface 'lan'
	option priority '200'
	option nopreempt '0'
	option advert_int '1'

config vip 'lan'
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.50.254'
	option netmask '255.255.255.0'

config peer 'peer1'
	option name 'node2'
	option address '172.30.0.11'

config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

config advanced 'advanced'
	option log_level '2'

config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'

== start_service
rc=1
== service_triggers
reload_trigger [ha-cluster]
== log
ha-cluster|daemon.info|Starting HA cluster
ha-cluster|daemon.info|Applying HA cluster configuration
ha-cluster|daemon.err|vrrp_instance main: VRID must be 1-127 (got: 128, 128-255 reserved for IPv6)
ha-cluster|daemon.err|Configuration validation failed
ha-cluster|daemon.err|Failed to apply configuration
== ls /tmp/ha-cluster
== /tmp/ha-cluster/keepalived.conf
(absent)
== /tmp/ha-cluster/owsync.conf
(absent)
== /tmp/ha-cluster/lease-sync.conf
(absent)
== ls /tmp/dnsmasq.cfg01411c.d
(absent)
== /tmp/dnsmasq.cfg01411c.d/ha-cluster.conf
(absent)
== ls /etc/ha-cluster
(absent)
== /etc/ha-cluster/service_states
(absent)
== rc.d
K01keepalived
K10lease-sync
K10owsync
K91ha-cluster
S25ha-cluster
S70keepalived
S99lease-sync
S99owsync
